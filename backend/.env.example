DATABASE_URL="postgresql://postgres:password@localhost:5432/unidorm?schema=public"
JWT_SECRET="replace-with-a-private-random-secret-at-least-32-characters-long"
ADMIN_REGISTRATION_KEY="replace-with-a-private-admin-registration-key"
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"
PORT=3001
# For production, set this to an absolute private persistent volume path outside the web root.
# Back up this directory together with PostgreSQL; payment receipt files are not stored in the database.
PAYMENT_PROOF_DIR=./uploads/payment-proofs
