datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  admin
}

enum BookingStatus {
  Pending
  Approved
  Rejected
}

enum AnnouncementAudience {
  ALL
  MALE
  FEMALE
}

enum ChatThreadType {
  GROUP
  DIRECT
}

enum ChatThreadStatus {
  PENDING
  ACCEPTED
  DENIED
}

enum PaymentCategory {
  ELECTRIC
  WATER
  ROOM
}

enum PaymentCycle {
  MONTHLY
  SEMESTER
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  PAID
  REJECTED
}

enum PaymentSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum NotificationType {
  BILL_CREATED
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_REJECTED
  ANNOUNCEMENT_PUBLISHED
  CHAT_MESSAGE
  ROOM_AVAILABLE
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  studentId  String?  @unique
  adminId    String?  @unique
  gender     String?
  password   String
  role       Role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  announcementReadReceipts AnnouncementReadReceipt[]
  verifiedPaymentBills PaymentBill[] @relation("PaymentBillVerifiedBy")
  reviewedPaymentSubmissions PaymentSubmission[] @relation("PaymentSubmissionReviewedBy")
  bookings Booking[]
  paymentBills PaymentBill[] @relation("PaymentBillStudent")
  notifications Notification[]

  @@index([role, createdAt])
}

model Room {
  id         Int      @id @default(autoincrement())
  roomNumber String   @unique
  gender     String?
  type       String
  furniture  String
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  bookings   Booking[]
  paymentBills PaymentBill[]

  @@index([gender, roomNumber])
}

model Booking {
  id         Int           @id @default(autoincrement())
  studentId  String
  roomNumber String
  type       String
  furniture  String
  price      Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(Pending)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now())  @updatedAt
  student    User          @relation(fields: [studentId], references: [studentId], onDelete: Restrict, onUpdate: Cascade)
  room       Room          @relation(fields: [roomNumber], references: [roomNumber], onDelete: Restrict, onUpdate: Cascade)

  @@index([studentId, status])
  @@index([roomNumber, status])
}

model Announcement {
  id          Int                  @id @default(autoincrement())
  title       String
  content     String
  audience    AnnouncementAudience @default(ALL)
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  readReceipts AnnouncementReadReceipt[]

  @@index([audience, createdAt])
}

model AnnouncementReadReceipt {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model ChatThread {
  id           Int              @id @default(autoincrement())
  chatKey      String           @unique
  type         ChatThreadType
  audienceGender String?
  studentId    String?
  adminId      String?
  status       ChatThreadStatus  @default(PENDING)
  adminLastReadAt DateTime?
  readReceipts ChatReadReceipt[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([studentId, status])
  @@index([adminId, status])
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  chatKey    String
  senderRole Role
  senderId   String
  content    String
  createdAt  DateTime @default(now())

  @@index([chatKey, createdAt])
}

model PaymentBill {
  id           Int            @id @default(autoincrement())
  studentId    String
  category     PaymentCategory
  cycle        PaymentCycle
  billingLabel String
  roomNumber   String?
  amount             Decimal        @db.Decimal(10, 2)
  status             PaymentStatus  @default(PENDING)
  dueDate            DateTime
  paidAt             DateTime?
  paymentReference   String?
  paymentNote        String?
  proofOriginalName  String?
  proofStorageName   String?
  proofMimeType      String?
  proofSize          Int?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedById       Int?
  rejectionReason    String?
  verifiedBy         User?          @relation("PaymentBillVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  student            User           @relation("PaymentBillStudent", fields: [studentId], references: [studentId], onDelete: Restrict, onUpdate: Cascade)
  room               Room?          @relation(fields: [roomNumber], references: [roomNumber], onDelete: Restrict, onUpdate: Cascade)
  submissions        PaymentSubmission[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@index([studentId, status, dueDate])
  @@index([status, submittedAt])
  @@index([verifiedById, verifiedAt])
  @@index([roomNumber])
}


model PaymentSubmission {
  id                Int                     @id @default(autoincrement())
  billId            Int
  paymentReference  String
  paymentNote       String?
  proofOriginalName String
  proofStorageName  String
  proofMimeType     String
  proofSize         Int
  status            PaymentSubmissionStatus @default(SUBMITTED)
  submittedAt       DateTime                @default(now())
  reviewedAt        DateTime?
  reviewerId        Int?
  rejectionReason   String?
  bill              PaymentBill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  reviewer          User?                   @relation("PaymentSubmissionReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([billId, submittedAt])
  @@index([status, submittedAt])
  @@index([reviewerId, reviewedAt])
}

model ChatReadReceipt {
  id         Int      @id @default(autoincrement())
  chatKey    String
  userRole   Role
  userId     String
  lastReadAt DateTime @default(now())
  lastReadMessageId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  thread     ChatThread @relation(fields: [chatKey], references: [chatKey], onDelete: Cascade)

  @@unique([chatKey, userRole, userId])
  @@index([userRole, userId, lastReadAt])
}


model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String           @db.VarChar(140)
  message   String           @db.VarChar(500)
  link      String?          @db.VarChar(240)
  entityId  Int?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}
